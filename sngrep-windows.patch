+// ncurses can not time out wgetch() on the Windows console: wait for a key here
+static int
+ui_input_ready(int msecs)
+{
+    HANDLE in = GetStdHandle(STD_INPUT_HANDLE);
+    DWORD mode, count, i;
+    INPUT_RECORD rec;
+    ULONGLONG deadline = GetTickCount64() + msecs;
+
+    // Not a console (pipe or file): let wgetch() block as usual
+    if (!GetConsoleMode(in, &mode))
+        return 1;
+
+    while (GetTickCount64() < deadline) {
+        if (!GetNumberOfConsoleInputEvents(in, &count))
+            return 1;
+        // Drop mouse, focus and key release events, they never produce a key
+        for (i = 0; i < count; i++) {
+            if (!PeekConsoleInput(in, &rec, 1, &i) || i == 0)
+                break;
+            if ((rec.EventType == KEY_EVENT && rec.Event.KeyEvent.bKeyDown)
+                || rec.EventType == MOUSE_EVENT)
+                return 1;
+            ReadConsoleInput(in, &rec, 1, &i);
+            count = 0;
+            GetNumberOfConsoleInputEvents(in, &count);
+            i = 0;
+        }
+        WaitForSingleObject(in, 20);
+    }
+    return 0;
+}
+#endif
