+#ifdef _WIN32
+// Find the local IPv4 address used to reach the Internet (no packet is sent)
+static in_addr_t
+capture_route_address(void)
+{
+    WSADATA wsa;
+    SOCKET sock;
+    struct sockaddr_in remote, local;
+    int len = sizeof(local);
+    in_addr_t addr = 0;
+
+    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0)
+        return 0;
+    memset(&remote, 0, sizeof(remote));
+    remote.sin_family = AF_INET;
+    remote.sin_port = htons(53);
+    remote.sin_addr.s_addr = inet_addr("8.8.8.8");
+    sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (sock != INVALID_SOCKET) {
+        if (connect(sock, (struct sockaddr *) &remote, sizeof(remote)) == 0
+            && getsockname(sock, (struct sockaddr *) &local, &len) == 0)
+            addr = local.sin_addr.s_addr;
+        closesocket(sock);
+    }
+    return addr;
+}
+
+// Npcap has no "any" device: use the interface holding the default route address,
+// or else the first running, connected, non loopback interface with an IPv4 address
+static const char *
+capture_default_device(char *errbuf)
+{
+    static char name[256];
+    pcap_if_t *devices, *dev;
+    pcap_addr_t *da;
+    in_addr_t route_addr = capture_route_address();
+    bool fallback = false;
+
+    if (pcap_findalldevs(&devices, errbuf) == -1)
+        return NULL;
+
+    name[0] = '\0';
+    for (dev = devices; dev; dev = dev->next) {
+        if ((dev->flags & PCAP_IF_LOOPBACK) || !(dev->flags & PCAP_IF_UP)
+            || !(dev->flags & PCAP_IF_RUNNING)
+            || (dev->flags & PCAP_IF_CONNECTION_STATUS) == PCAP_IF_CONNECTION_STATUS_DISCONNECTED)
+            continue;
+        for (da = dev->addresses; da; da = da->next) {
+            if (!da->addr || da->addr->sa_family != AF_INET)
+                continue;
+            if (route_addr && ((struct sockaddr_in *) da->addr)->sin_addr.s_addr == route_addr) {
+                strncpy(name, dev->name, sizeof(name) - 1);
+                pcap_freealldevs(devices);
+                return name;
+            }
+            if (!fallback) {
+                strncpy(name, dev->name, sizeof(name) - 1);
+                fallback = true;
+            }
+        }
+    }
+    pcap_freealldevs(devices);
+
+    if (!name[0]) {
+        snprintf(errbuf, PCAP_ERRBUF_SIZE, "no usable network interface found");
+        return NULL;
+    }
+    return name;
+}
+#endif
